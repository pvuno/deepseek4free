# ---------------------------------------------------------------------------
# deepseek4free configuration
# Copy this file to .env (or export the variables) and edit the values.
# The proxy reads .env only if you run it with `node --env-file=.env src/index.js`
# or use a process manager that loads it. Native `npm start` does NOT load .env.
# ---------------------------------------------------------------------------

# Where the OpenAI-compatible API listens.
HOST=127.0.0.1
PORT=9270

# Tokens file (one token or email:password per line).
TOKENS_FILE=tokens.txt

# Alternative to tokens.txt: one token, or several comma-separated.
# Takes effect only when tokens.txt has no valid entries.
# DEEPSEEK_TOKEN=
# DEEPSEEK_TOKENS=

# Persisted thread IDs. Safe to delete; the proxy will recreate sessions.
SESSIONS_FILE=data/sessions.json

# Protect the local API. Required if HOST is not 127.0.0.1.
# Clients must send: Authorization: Bearer <PROXY_API_KEY>
PROXY_API_KEY=

# --- DeepSeek client -------------------------------------------------------
DEEPSEEK_BASE_URL=https://chat.deepseek.com

# android (verified default) or web (browser-like headers)
DEEPSEEK_PROFILE=android
DEEPSEEK_CLIENT_VERSION=2.0.4
DEEPSEEK_CLIENT_PLATFORM=android
DEEPSEEK_CLIENT_LOCALE=zh_CN
DEEPSEEK_ANDROID_API_LEVEL=35

# Used only with DEEPSEEK_PROFILE=web
DEEPSEEK_WEB_APP_VERSION=20241129.1
DEEPSEEK_WEB_CLIENT_VERSION=1.0.0-always
# DEEPSEEK_USER_AGENT=Mozilla/5.0 ...

# Optional Cloudflare cookies (same file format as xtekky/deepseek4free)
COOKIES_FILE=data/cookies.json
# CF_CLEARANCE=

# Enable DeepSeek-side web search by default (per-request: "search": true)
SEARCH_ENABLED=0

# Optional: used only when a token entry is user@example.com:password
# DEEPSEEK_EMAIL=
# DEEPSEEK_PASSWORD=

# --- behaviour -------------------------------------------------------------
# "off" = fast model by default, "on" = reasoning by default.
# Model name deepseek-reasoner always enables thinking.
THINKING=off

# Retry/rotation
MAX_RETRIES=3
TOKEN_COOLDOWN_MS=600000
REQUEST_TIMEOUT_MS=120000
IDLE_TIMEOUT_MS=60000

# Gentle pacing per account (anti-ban). The proxy runs one upstream request
# per token at a time and waits this long before the next one.
# Set MIN_REQUEST_INTERVAL_MS=0 to disable the delay.
MIN_REQUEST_INTERVAL_MS=1500
REQUEST_JITTER_MS=500
RATE_LIMIT_COOLDOWN_MS=60000

# DeepSeek sometimes returns INCOMPLETE; continue the answer automatically.
AUTO_CONTINUE=1
MAX_CONTINUE_ROUNDS=4

# Drop unused threads after 6 hours.
SESSION_TTL_MS=21600000
# Sessions are written to data/sessions.json immediately, so a restart
# continues the same DeepSeek chat instead of creating a new one.

# 1 = solve PoW in a worker thread (does not block the HTTP server).
# 0 = solve inline (useful for debugging).
POW_WORKERS=1

# error | warn | info | debug
LOG_LEVEL=info